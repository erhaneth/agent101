# Copy to .env and fill in values

GOOGLE_API_KEY=
TAVILY_API_KEY=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Auth
AUTH_SECRET_KEY=generate-a-long-random-string
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_BACKEND_URL=http://127.0.0.1:8000
AUTH_COOKIE_SECURE=false
AUTH_REQUIRED=true
# Optional comma-separated browser origins. In production, every origin must be
# a real HTTPS origin and include AUTH_FRONTEND_URL. If omitted, the app uses
# AUTH_FRONTEND_URL only in production and adds local Vite origins in development.
CORS_ORIGINS=

# Set AUTH_REQUIRED=false to skip login in local dev (uses dev-local user)

# Storage
# Defaults to data/factcrafter.db for local development.
AUTH_DB_PATH=
AUTH_DATABASE_URL=
JOB_DB_PATH=
# Use this for shared web/worker job storage in production.
JOB_DATABASE_URL=
# Optional durable run artifact mirror. Use this in production if the web and worker
# do not share a persistent mounted RUN_ARTIFACT_DIR.
ARTIFACT_DATABASE_URL=
ARTIFACT_DB_PATH=

# Jobs
# thread = API starts a background thread after creating a job (local default).
# external = API only enqueues; run `python worker.py` in a separate process.
# external requires shared JOB_DATABASE_URL or another shared job store.
JOB_EXECUTION_MODE=thread
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_SECONDS=900

# Optional incident-response webhook for failed/blocked jobs.
# The app POSTs a small JSON payload when terminal job failures need attention.
ALERT_WEBHOOK_URL=

# Hosted smoke-check target used by GitHub Actions.
FACTCRAFTER_SMOKE_URL=

# Abuse controls
# Set to 0 to disable a specific local limit.
MAX_ACTIVE_JOBS_PER_USER=3
MAX_JOB_CREATES_PER_WINDOW=10
JOB_CREATE_WINDOW_SECONDS=3600

# Production
# ENVIRONMENT=production requires AUTH_SECRET_KEY to be explicitly set.
# Set AUTH_COOKIE_SECURE=true when serving over HTTPS.
ENVIRONMENT=development
